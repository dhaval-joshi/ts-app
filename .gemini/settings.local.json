{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)"
    ],
    "allow": [
      "Bash",
      "py_compile",
      "node --check",
      "git status",
      "git diff",
      "git log"
    ],
    "ask": [
      "Bash(uvicorn*)",
      "Bash(git push *)",
      "Bash(git commit)",
      "Bash(git push -u origin refs/refs/changes/*)"
    ]
  }
}