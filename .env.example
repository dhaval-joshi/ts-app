# Copy this file to .env and fill in your details.

# Your app's API key from https://developer.tradejini.com/developer-portal
TRADEJINI_API_KEY=

# Your Tradejini login password
TRADEJINI_PASSWORD=

# Base32 TOTP secret from your authenticator app setup on cubeplus.tradejini.com
# (Settings -> the QR code shown when enabling the authenticator app).
# The app uses this to auto-generate a fresh 6-digit code on every login,
# so you never have to paste a one-time code by hand.
TRADEJINI_TOTP_SECRET=

# host used by both the REST API and the streaming socket, normally leave as-is
TRADEJINI_HOST=api.tradejini.com

# How often (seconds) the background scheduler checks time-based exits
EXIT_CHECK_INTERVAL_SECONDS=5

# Minimum seconds between two trailing-SL/target modify calls for the same order
TRAIL_MODIFY_MIN_INTERVAL_SECONDS=2

# Port the local web app listens on
APP_PORT=8000

# Login for THIS APP -- separate from your Tradejini credentials above.
# Required: the app refuses to start at all if either of these is blank.
# Plain text, single shared login, no user accounts -- deliberately simple
# for a single-operator local app. Pick your own values.
APP_LOGIN_USERNAME=
APP_LOGIN_PASSWORD=

# How many days a login stays valid before you need to sign in again
SESSION_TTL_DAYS=7
